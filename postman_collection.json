{
  "info": {
    "name": "Social API - Assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create a new post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"authorId\": 1,\n    \"authorType\": \"USER\",\n    \"content\": \"My first post\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/posts",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts"]
        }
      }
    },
    {
      "name": "Add a comment to a post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"authorId\": 1,\n    \"authorType\": \"BOT\",\n    \"content\": \"Nice post!\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/posts/1/comments",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "1", "comments"]
        }
      }
    },
    {
      "name": "Like a post",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": ""
        },
        "url": {
          "raw": "http://localhost:8080/api/posts/1/like?userId=1",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "posts", "1", "like"],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        }
      }
    }
  ]
}
